# Arpie Environment Configuration (Optional)
# Threat Intelligence API Keys (optional - Arpie still functions offline without keys)
ABUSEIPDB_API_KEY=
IPINFO_API_KEY=

# Data directory for the database + exported reports.
# Defaults to a per-OS user data dir:
#   Windows: %APPDATA%\Arpie   macOS: ~/Library/Application Support/Arpie
#   Linux:   ~/.local/share/arpie
# ARPIE_DATA_DIR=

# Custom database path (overrides ARPIE_DATA_DIR for the DB only)
# ARPIE_DB_PATH=

# Force specific network interface (leave blank for automatic detection)
ARPIE_IFACE=
