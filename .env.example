# Arpie Environment Configuration (Optional)
# Threat Intelligence API Keys (optional - Arpie still functions offline without keys)
ABUSEIPDB_API_KEY=
IPINFO_API_KEY=

# Custom database path (defaults to arpie.db in working directory)
ARPIE_DB_PATH=arpie.db

# Force specific network interface (leave blank for automatic detection)
ARPIE_IFACE=
